# ==============================================================================
# ExamSphere - Mobile App (React Native / Expo) Environment Variables Template
# ==============================================================================

# Backend API Base URL (Use local network IP or emulator loopback: Android emulator uses 10.0.2.2)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api

# Real-Time WebSocket Server (Socket.io)
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# Cloudinary (Media rendering, exam proctor snapshots, certificates)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Firebase Cloud Messaging / Expo Push Notifications
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_SENDER_ID=your_firebase_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
