# ==============================================================================
# ExamSphere - Mobile App (React Native / Expo) Environment Template (.env.example)
# ==============================================================================

# Backend API Base URL
# - Android Emulator: http://10.0.2.2:5000/api
# - iOS Simulator / Expo Web: http://localhost:5000/api
# - Physical Mobile Device (WiFi LAN): http://<YOUR_LOCAL_IP>:5000/api (e.g. http://192.168.1.100:5000/api)
# - Production: https://api.yourdomain.com/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api

# Real-Time WebSocket Server (Socket.io)
# - Android Emulator: http://10.0.2.2:5000
# - iOS Simulator / Expo Web: http://localhost:5000
# - Physical Mobile Device (WiFi LAN): http://<YOUR_LOCAL_IP>:5000 (e.g. http://192.168.1.100:5000)
# - Production: https://api.yourdomain.com
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# Firebase Cloud Messaging / Expo Push Notifications (Optional)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# EAS Build Configuration (Optional - set when running `eas build`)
EAS_PROJECT_ID=
