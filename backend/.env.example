# ==============================================================================
# ExamSphere - Backend Environment Variables Template
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/exam-sphere?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (Proctoring Snapshots & Generated Certificates)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Cloud Messaging (FCM for Push Notifications)
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=your_firebase_client_email
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key\n-----END PRIVATE KEY-----\n"

# Background Job Queue & Cache (BullMQ / Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Socket.io Real-Time Proctoring & Leaderboards
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Initial Platform Administrator Seed Credentials
ADMIN_EMAIL=admin@examsphere.com
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Code Execution Sandbox (Judge0)
# Use https://ce.judge0.com (public) or https://judge0-ce.p.rapidapi.com with RapidAPI credentials
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Anti-Cheat Proctoring Security Rules
VIOLATION_FLAG_THRESHOLD=5

