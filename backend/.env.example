# ==============================================================================
# ExamSphere - Backend Environment Variables Template (.env.example)
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:19006,http://localhost:8081

# Database Connection (MongoDB Atlas or Local Instance)
# For Local: mongodb://127.0.0.1:27017/examsphere
# For Production: mongodb+srv://<username>:<password>@cluster0.mongodb.net/examsphere?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/examsphere

# JWT Authentication (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_64_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_key_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Storage Configuration (Local Disk Storage - served statically via /uploads)
UPLOADS_DIR=uploads
PUBLIC_BASE_URL=http://localhost:5000
API_PUBLIC_URL=http://localhost:5000

# Socket.io Real-Time Proctoring & Leaderboards
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:19006,http://localhost:8081

# Initial Platform Administrator Seed Credentials
ADMIN_EMAIL=admin@examsphere.com
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Anti-Cheat Proctoring Security Rules (Threshold before flagging session)
VIOLATION_FLAG_THRESHOLD=3


# Firebase Cloud Messaging (FCM Push Notifications - Optional)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Email Configuration (Nodemailer SMTP - Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ExamSphere" <noreply@examsphere.com>
